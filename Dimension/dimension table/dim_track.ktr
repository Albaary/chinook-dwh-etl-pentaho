  <step>
    <name>staging_track</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>chinook_staging</connection>
    <sql>SELECT 
    t.track_id,
    t."name" AS track_name,
    al.title AS album_title,
    ar."name" AS artist_name,
    g."name" AS genre_name,
    m."name" AS media_type_name,
    t.composer,
    t.unit_price,
	CASE 
        WHEN t.milliseconds &lt; 180000 THEN 'Pendek'       -- &lt; 3 menit
        WHEN t.milliseconds BETWEEN 180000 AND 300000 THEN 'Standar' -- 3-5 menit
        ELSE 'Epik'                                       -- > 5 menit
    END AS duration_category
FROM staging.track t
LEFT JOIN staging.album al ON t.album_id = al.album_id
LEFT JOIN staging.artist ar ON al.artist_id = ar.artist_id
LEFT JOIN staging.genre g ON t.genre_id = g.genre_id
LEFT JOIN staging.media_type m ON t.media_type_id = m.media_type_id;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
